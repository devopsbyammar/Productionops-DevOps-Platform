pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate SonarQube Access') {
            steps {
                withCredentials([string(
                    credentialsId: 'sonarqube-token',
                    variable: 'SONAR_TOKEN'
                )]) {
                    sh '''
                        echo "=== Token Validation ==="
                        curl -s -u "$SONAR_TOKEN:" \
                            http://10.210.168.28:9000/api/authentication/validate

                        echo
                        echo "=== Authenticated User ==="
                        curl -s -u "$SONAR_TOKEN:" \
                            http://10.210.168.28:9000/api/users/current

                        echo
                        echo "=== ProductionOps Project Permissions ==="
                        curl -s -u "$SONAR_TOKEN:" \
                            "http://10.210.168.28:9000/api/permissions/users?projectKey=productionops&q=admin"

                        echo
                    '''
                }
            }
        }

        stage('Install Test Dependencies') {
            steps {
                sh '''
                    python3 -m venv .venv-ci
                    .venv-ci/bin/pip install --upgrade pip
                    .venv-ci/bin/pip install -r day-01/requirements.txt
                    .venv-ci/bin/pip install -r day-01/requirements-test.txt
                '''
            }
        }

        stage('Unit Tests') {
            steps {
                sh '''
                    .venv-ci/bin/pytest -q day-01/test_app.py
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([string(
                        credentialsId: 'sonarqube-token',
                        variable: 'SONAR_TOKEN'
                    )]) {
                        sh """
                            ${tool 'SonarScanner'}/bin/sonar-scanner \
                              -Dsonar.projectKey=ProductionOps \
                              -Dsonar.projectName=ProductionOps \
                              -Dsonar.sources=day-01 \
                              -Dsonar.exclusions=day-01/.venv/**,day-01/__pycache__/** \
                              -Dsonar.python.version=3.12 \
                              -Dsonar.token=\\\$SONAR_TOKEN
                        """
                    }
                }
            }
        }

        stage('Trivy Security Scan') {
            steps {
                sh '''
                    echo "=== Trivy Security Scan ==="
                    trivy image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        production-app:1.0.0
                '''
            }
        }
    }

    post {
        always {
            sh 'rm -rf .venv-ci'
        }
    }
}

